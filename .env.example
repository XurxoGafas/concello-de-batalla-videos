# Copia este archivo como .env y rellena los valores reales (nunca subas .env al repositorio)

# Semilla secreta de la serie (cualquier texto largo; no la subas ni la cambies a mitad de serie)
SEMILLA_SERIE=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
